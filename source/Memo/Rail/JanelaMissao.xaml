<Window x:Class="Memo.Rail.JanelaMissao"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Missão do dia" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="Segoe UI" Background="{DynamicResource CorFundo}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho: cerebrinho roxo + título + testar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="🧠" FontSize="22" Margin="0,0,10,0"
                       Foreground="{DynamicResource CorDestaque}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Missão do dia" Foreground="{DynamicResource CorTexto}"
                       FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="⚙" FontSize="14" Padding="10,5" Margin="0,0,6,0"
                    ToolTip="Configurar o Memo Rail" Click="Config_Click" />
            <Button Grid.Column="3" Content="Testar" FontSize="12" Padding="10,5"
                    ToolTip="Mostra como o cerebrinho vai aparecer no canto da tela"
                    Click="Testar_Click" />
        </Grid>

        <TextBlock x:Name="textoProgresso" Grid.Row="1" Margin="0,6,0,14"
                   Foreground="{DynamicResource CorTextoFraco}" FontSize="13"
                   Text="O que vamos fazer hoje? Liste as tarefas — o Memo te mantém no trilho."
                   TextWrapping="Wrap" />

        <!-- Cards das tarefas (montados no code-behind) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="360">
            <StackPanel x:Name="painelItens" />
        </ScrollViewer>

        <!-- Adicionar tarefa -->
        <Border Grid.Row="3" Margin="0,12,0,0" CornerRadius="10" Padding="14,12"
                Background="{DynamicResource CorPainel}">
            <StackPanel>
                <TextBlock Text="NOVA TAREFA" Foreground="{DynamicResource CorTextoFraco}"
                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="campoNova" MinHeight="56" MaxHeight="120"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         PreviewKeyDown="Nova_KeyDown" />
                <TextBlock Foreground="{DynamicResource CorTextoFraco}" FontSize="11"
                           Margin="0,4,0,10" TextWrapping="Wrap"
                           Text="Enter adiciona · Shift+Enter quebra linha · **negrito** · *itálico* · link no texto vira o 🔗" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="PARA O DIA" Foreground="{DynamicResource CorTextoFraco}"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <DatePicker x:Name="campoDataNova" Width="130"
                                    SelectedDateFormat="Short" FirstDayOfWeek="Monday" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Hoje" Click="DataHoje_Click"
                            VerticalAlignment="Bottom" Margin="0,0,6,0" Padding="10,6" FontSize="12" />
                    <Button Grid.Column="2" Content="Amanhã" Click="DataAmanha_Click"
                            VerticalAlignment="Bottom" Padding="10,6" FontSize="12" />
                    <Button Grid.Column="4" Content="+ Adicionar" VerticalAlignment="Bottom"
                            Style="{StaticResource BotaoPrimario}" Click="Adicionar_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="botaoLimpar" Content="Recomeçar o dia" Style="{StaticResource BotaoPerigo}"
                    Click="Limpar_Click" Margin="0,0,8,0" />
            <Button Content="Fechar" Click="Fechar_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
