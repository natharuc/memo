<Window x:Class="Memo.Rail.JanelaBloqueio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" Title="Modo foco">
    <Grid>
        <!-- Backdrop "embaçado": quase opaco, esconde a distração por trás. -->
        <Rectangle Fill="#F5141420" />
        <Rectangle Opacity="0.06">
            <Rectangle.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#7A89FF" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
            <Rectangle.Effect>
                <BlurEffect Radius="80" />
            </Rectangle.Effect>
        </Rectangle>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
            <TextBlock Text="🧠" FontSize="72" HorizontalAlignment="Center"
                       Foreground="#7A89FF" />
            <TextBlock Text="Modo foco ativo" HorizontalAlignment="Center" Margin="0,10,0,0"
                       Foreground="#FFFFFF" FontSize="30" FontWeight="SemiBold" />
            <TextBlock x:Name="textoTarefa" HorizontalAlignment="Center" Margin="0,10,0,0"
                       Foreground="#DCDFEB" FontSize="16" TextWrapping="Wrap"
                       TextAlignment="Center" />
            <TextBlock Text="Essa distração está bloqueada. Feche-a e volte pro trilho."
                       HorizontalAlignment="Center" Margin="0,14,0,0"
                       Foreground="#8C91AA" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock x:Name="textoContagem" HorizontalAlignment="Center" Margin="0,22,0,0"
                       Foreground="#7A89FF" FontSize="15" FontWeight="SemiBold" />
            <Button x:Name="botaoEncerrar" Content="encerrar modo foco"
                    HorizontalAlignment="Center" Margin="0,26,0,0"
                    Background="Transparent" Foreground="#8C91AA" FontSize="12"
                    BorderThickness="0" Cursor="Hand" Padding="8,4"
                    Click="Encerrar_Click" />
        </StackPanel>
    </Grid>
</Window>
