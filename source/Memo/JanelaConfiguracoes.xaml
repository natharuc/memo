<Window x:Class="Memo.JanelaConfiguracoes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações" Width="560" MinHeight="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Segoe UI" Background="{DynamicResource CorFundo}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Configurações"
                   Foreground="{DynamicResource CorTexto}" FontSize="20" FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <TabControl Grid.Row="1">

            <!-- ===== Preferências ===== -->
            <TabItem Header="Preferências">
                <StackPanel>
                    <!-- Tema -->
                    <TextBlock Text="TEMA" Foreground="{DynamicResource CorTextoFraco}"
                               FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel x:Name="painelTema" Orientation="Horizontal" Margin="0,0,0,20">
                        <Button Content="Escuro" Tag="Escuro" Click="Tema_Click" Margin="0,0,8,0" />
                        <Button Content="Claro" Tag="Claro" Click="Tema_Click" />
                    </StackPanel>

                    <!-- Duração da sessão -->
                    <TextBlock Text="TEMPO PARA GUARDAR A SENHA"
                               Foreground="{DynamicResource CorTextoFraco}"
                               FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="Depois de destrancar, o cofre fica acessível por esse tempo sem pedir a senha de novo."
                               Foreground="{DynamicResource CorTextoFraco}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,10" />
                    <WrapPanel x:Name="painelDuracao">
                        <Button Content="15 min" Tag="15" Click="Duracao_Click" Margin="0,0,8,8" />
                        <Button Content="30 min" Tag="30" Click="Duracao_Click" Margin="0,0,8,8" />
                        <Button Content="1 hora" Tag="60" Click="Duracao_Click" Margin="0,0,8,8" />
                        <Button Content="4 horas" Tag="240" Click="Duracao_Click" Margin="0,0,8,8" />
                        <Button Content="8 horas" Tag="480" Click="Duracao_Click" Margin="0,0,8,8" />
                        <Button Content="1 dia" Tag="1440" Click="Duracao_Click" Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>
            </TabItem>

            <!-- ===== Atalhos ===== -->
            <TabItem Header="Atalhos">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource CorTextoFraco}" FontSize="12"
                               Margin="0,0,0,12"
                               Text="Comandos para usar no terminal (Win+R, cmd ou PowerShell). Onde aparece &lt;nome&gt;, troque pelo nome do seu documento." />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                        <StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource CorDestaque}"
                                           Text="memo get &lt;nome&gt;" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource CorTextoFraco}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="Copia o valor (senha) do documento para a área de transferência." />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource CorDestaque}"
                                           Text="memo set &lt;nome&gt; = &lt;valor&gt;" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource CorTextoFraco}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="Cria um documento novo ou atualiza um existente com o valor informado." />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource CorDestaque}"
                                           Text="memo new" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource CorTextoFraco}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="Abre a janela para criar um documento, sem precisar abrir o app inteiro." />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource CorDestaque}"
                                           Text="memo pass [&lt;nome&gt;]" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource CorTextoFraco}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="Gera uma senha forte e copia. Se você der um nome, também salva como documento." />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource CorDestaque}"
                                           Text="memo guid" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource CorTextoFraco}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="Gera um identificador único (GUID) e copia para a área de transferência." />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource CorDestaque}"
                                           Text="memo lock" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource CorTextoFraco}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="Tranca o cofre na hora. O próximo acesso vai pedir a senha-mestra de novo." />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource CorDestaque}"
                                           Text="memo unlock" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource CorTextoFraco}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="Destranca o cofre pedindo a senha (deixa pronto para usar sem pedir de novo)." />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource CorDestaque}"
                                           Text="memo remember &lt;texto&gt; &lt;quando&gt;" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource CorTextoFraco}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="Cria um lembrete em linguagem natural. Ex.: &quot;ver tarefa 477987 10:00 tomorrow&quot;, &quot;22h&quot;, &quot;beber agua every 30 minutes&quot;." />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource CorDestaque}"
                                           Text="memo rail [add &lt;tarefa&gt; | done &lt;n&gt;]" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource CorTextoFraco}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="Missão do dia do Memo Rail: sem nada abre o checklist; add adiciona tarefa; done conclui." />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource CorDestaque}"
                                           Text="memo migrar" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource CorTextoFraco}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="Reorganiza/atualiza os documentos antigos para o formato de criptografia atual." />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource CorDestaque}"
                                           Text="memo" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource CorTextoFraco}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="Sem nada depois, abre a interface gráfica (esta janela do app)." />
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </TabItem>

            <!-- ===== Notificações ===== -->
            <TabItem Header="Notificações">
                <DockPanel>
                    <!-- Status do teste, compartilhado pelos canais -->
                    <TextBlock x:Name="notifStatus" DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="12"
                               Margin="0,12,0,0" Foreground="{DynamicResource CorTextoFraco}"
                               Visibility="Collapsed" />

                    <TabControl>

                        <!-- Telegram -->
                        <TabItem Header="Telegram">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                                <StackPanel Margin="0,4,8,0">
                                    <CheckBox x:Name="tgHabilitado" Content="Habilitar Telegram"
                                              FontWeight="SemiBold" Margin="0,0,0,14" />
                                    <TextBlock Text="BOT TOKEN" Foreground="{DynamicResource CorTextoFraco}"
                                               FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox x:Name="tgToken" Margin="0,0,0,12" />
                                    <TextBlock Text="CHAT ID" Foreground="{DynamicResource CorTextoFraco}"
                                               FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox x:Name="tgChatId" Margin="0,0,0,14" />
                                    <Button Content="Testar Telegram" HorizontalAlignment="Left"
                                            Click="TestarTelegram_Click" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- E-mail -->
                        <TabItem Header="E-mail">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                                <StackPanel Margin="0,4,8,0">
                                    <CheckBox x:Name="emHabilitado" Content="Habilitar e-mail (SMTP)"
                                              FontWeight="SemiBold" Margin="0,0,0,14" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="SERVIDOR SMTP" Foreground="{DynamicResource CorTextoFraco}"
                                                       FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <TextBox x:Name="emServidor" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="PORTA" Foreground="{DynamicResource CorTextoFraco}"
                                                       FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <TextBox x:Name="emPorta" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="emSsl" Content="Usar SSL/TLS" Margin="0,0,0,12" />
                                    <TextBlock Text="USUÁRIO" Foreground="{DynamicResource CorTextoFraco}"
                                               FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox x:Name="emUsuario" Margin="0,0,0,12" />
                                    <TextBlock Text="SENHA" Foreground="{DynamicResource CorTextoFraco}"
                                               FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <PasswordBox x:Name="emSenha" Margin="0,0,0,12" />
                                    <TextBlock Text="DE (REMETENTE)" Foreground="{DynamicResource CorTextoFraco}"
                                               FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox x:Name="emDe" Margin="0,0,0,12" />
                                    <TextBlock Text="PARA (DESTINATÁRIO)" Foreground="{DynamicResource CorTextoFraco}"
                                               FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox x:Name="emPara" Margin="0,0,0,14" />
                                    <Button Content="Testar e-mail" HorizontalAlignment="Left"
                                            Click="TestarEmail_Click" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                    </TabControl>
                </DockPanel>
            </TabItem>

            <!-- ===== Memo Rail ===== -->
            <TabItem Header="Memo Rail">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                    <StackPanel Margin="0,4,8,0">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource CorTextoFraco}" FontSize="12"
                                   Margin="0,0,0,12"
                                   Text="Assistente de foco: pergunta a missão do dia, faz check-ins periódicos e avisa quando detecta distração. Tudo é analisado localmente e nada é gravado — só o título da janela ativa é lido, em memória." />

                        <CheckBox x:Name="railHabilitado" Content="Habilitar Memo Rail"
                                  FontWeight="SemiBold" Margin="0,0,0,10" />
                        <CheckBox x:Name="railPerguntar" Content="Perguntar a missão do dia ao iniciar"
                                  Margin="0,0,0,16" />

                        <TextBlock Text="CHECK-IN A CADA" Foreground="{DynamicResource CorTextoFraco}"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel x:Name="painelRailCheckIn" Margin="0,0,0,12">
                            <Button Content="25 min" Tag="25" Click="RailCheckIn_Click" Margin="0,0,8,8" />
                            <Button Content="45 min" Tag="45" Click="RailCheckIn_Click" Margin="0,0,8,8" />
                            <Button Content="1 hora" Tag="60" Click="RailCheckIn_Click" Margin="0,0,8,8" />
                            <Button Content="1h30" Tag="90" Click="RailCheckIn_Click" Margin="0,0,8,8" />
                        </WrapPanel>

                        <TextBlock Text="NÍVEL DE DISTRAÇÃO" Foreground="{DynamicResource CorTextoFraco}"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel x:Name="painelRailNivel" Margin="0,0,0,4">
                            <Button Content="Baixo" Tag="Baixo" Click="RailNivel_Click" Margin="0,0,8,8" />
                            <Button Content="Médio" Tag="Medio" Click="RailNivel_Click" Margin="0,0,8,8" />
                            <Button Content="Alto" Tag="Alto" Click="RailNivel_Click" Margin="0,0,8,8" />
                            <Button Content="Muito alto" Tag="MuitoAlto" Click="RailNivel_Click" Margin="0,0,8,8" />
                            <Button Content="TDAH 🧠" Tag="TDAH" Click="RailNivel_Click" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock x:Name="railNivelDescricao" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource CorTextoFraco}" Margin="0,0,0,12" />

                        <TextBlock Text="HORÁRIO DE ATUAÇÃO" Foreground="{DynamicResource CorTextoFraco}"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBox x:Name="railInicio" Width="92" FontSize="15"
                                     HorizontalContentAlignment="Center" MaxLength="5" />
                            <TextBlock Text="até" Foreground="{DynamicResource CorTextoFraco}"
                                       VerticalAlignment="Center" Margin="12,0" />
                            <TextBox x:Name="railFim" Width="92" FontSize="15"
                                     HorizontalContentAlignment="Center" MaxLength="5" />
                        </StackPanel>
                        <TextBlock Text="Formato 24h — ex.: 09:00 às 18:00 (é só digitar os números)."
                                   Foreground="{DynamicResource CorTextoFraco}" FontSize="11"
                                   Margin="0,0,0,12" TextWrapping="Wrap" />

                        <TextBlock Text="DIAS DA SEMANA" Foreground="{DynamicResource CorTextoFraco}"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel x:Name="painelRailDias" Margin="0,0,0,16">
                            <Button Content="Seg" Tag="1" Click="RailDia_Click" Margin="0,0,6,8" Padding="10,5" FontSize="12" />
                            <Button Content="Ter" Tag="2" Click="RailDia_Click" Margin="0,0,6,8" Padding="10,5" FontSize="12" />
                            <Button Content="Qua" Tag="3" Click="RailDia_Click" Margin="0,0,6,8" Padding="10,5" FontSize="12" />
                            <Button Content="Qui" Tag="4" Click="RailDia_Click" Margin="0,0,6,8" Padding="10,5" FontSize="12" />
                            <Button Content="Sex" Tag="5" Click="RailDia_Click" Margin="0,0,6,8" Padding="10,5" FontSize="12" />
                            <Button Content="Sáb" Tag="6" Click="RailDia_Click" Margin="0,0,6,8" Padding="10,5" FontSize="12" />
                            <Button Content="Dom" Tag="0" Click="RailDia_Click" Margin="0,0,6,8" Padding="10,5" FontSize="12" />
                        </WrapPanel>

                        <TextBlock Text="DISTRAÇÕES (UMA POR LINHA)" Foreground="{DynamicResource CorTextoFraco}"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource CorTextoFraco}" FontSize="12"
                                   Margin="0,0,0,8"
                                   Text="Se o título da janela ativa (ou o nome do programa) contiver um destes termos, conta como distração." />
                        <TextBox x:Name="railDistracoes" MinHeight="90" MaxHeight="140"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Click="Cancelar_Click" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Salvar" Style="{StaticResource BotaoPrimario}"
                    Click="Salvar_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
