<Window x:Class="Memo.JanelaAuthEditar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar chave" Width="520" SizeToContent="Height" MaxHeight="760"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Icon="memo.ico"
        FontFamily="Segoe UI" Background="{DynamicResource CorFundo}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock x:Name="textoTitulo" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource CorTexto}" />
            <TextBlock x:Name="textoRotulo" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource CorTextoFraco}" FontSize="13" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="520">
            <StackPanel>
                <StackPanel x:Name="painelEdicao" IsEnabled="False">
                    <TextBlock Text="Serviço / nome" Foreground="{DynamicResource CorTextoFraco}" />
                    <TextBox x:Name="campoServico" Margin="0,6,0,14" MaxLength="512" />
                    <TextBlock Text="Conta / e-mail" Foreground="{DynamicResource CorTextoFraco}" />
                    <TextBox x:Name="campoConta" Margin="0,6,0,14" MaxLength="512" />
                    <StackPanel x:Name="painelSegredo">
                        <TextBlock Text="Nova chave secreta (Base32)" Foreground="{DynamicResource CorTextoFraco}" />
                        <PasswordBox x:Name="campoSegredo" Margin="0,6,0,4" />
                        <TextBlock Text="Deixe vazio para manter a chave atual." FontSize="12"
                                   Foreground="{DynamicResource CorTextoFraco}" Margin="0,0,0,16" />
                        <Expander Header="Parâmetros TOTP" Foreground="{DynamicResource CorTexto}">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Algoritmo" Foreground="{DynamicResource CorTextoFraco}" />
                                <ComboBox x:Name="campoAlgoritmo" Margin="0,6,0,12">
                                    <ComboBoxItem Content="SHA1" /><ComboBoxItem Content="SHA256" /><ComboBoxItem Content="SHA512" />
                                </ComboBox>
                                <TextBlock Text="Dígitos" Foreground="{DynamicResource CorTextoFraco}" />
                                <ComboBox x:Name="campoDigitos" Margin="0,6,0,12">
                                    <ComboBoxItem Content="6" /><ComboBoxItem Content="7" /><ComboBoxItem Content="8" />
                                </ComboBox>
                                <TextBlock Text="Período em segundos" Foreground="{DynamicResource CorTextoFraco}" />
                                <TextBox x:Name="campoPeriodo" Margin="0,6,0,0" MaxLength="5" />
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="Altere a chave e os parâmetros apenas se o serviço da conta fornecer novos dados."
                                   TextWrapping="Wrap" FontSize="12" Margin="0,16,0,0"
                                   Foreground="{DynamicResource CorTextoFraco}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="painelRemocao" Visibility="Collapsed">
                    <Border Background="{DynamicResource CorPainel}" BorderBrush="{DynamicResource CorPerigo}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,18">
                        <TextBlock Text="A chave será removida do Ente e dos dispositivos sincronizados. Garanta outra forma de acesso à conta."
                                   TextWrapping="Wrap" Foreground="{DynamicResource CorPerigo}" />
                    </Border>
                    <TextBlock Text="Confirme com a senha-mestra do cofre Memo" TextWrapping="Wrap"
                               Foreground="{DynamicResource CorTexto}" />
                    <PasswordBox x:Name="campoSenhaCofre" Margin="0,8,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="textoStatus" Grid.Row="2" Text="Carregando chave do Ente…"
                   Foreground="{DynamicResource CorTextoFraco}" TextWrapping="Wrap" Margin="0,16,0,0" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="botaoCancelar" Content="Cancelar" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="botaoConfirmar" Content="Salvar" IsDefault="True" IsEnabled="False"
                    Style="{StaticResource BotaoPrimario}" Click="Confirmar_Click" />
        </StackPanel>
    </Grid>
</Window>
