<Window x:Class="Memo.JanelaAuth"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Memo"
        Title="Auth" Width="980" Height="720"
        MinWidth="720" MinHeight="480"
        Icon="memo.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Background="{DynamicResource CorFundo}"
        KeyboardNavigation.DirectionalNavigation="None"
        PreviewKeyDown="Janela_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="CartaoAuth" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CorPainel}" />
            <Setter Property="Foreground" Value="{DynamicResource CorTexto}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="336" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource CorCampo}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Selecionado}" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource CorDestaque}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Auth" Foreground="{DynamicResource CorTexto}"
                           FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Enter copia · setas navegam · Ctrl+F busca · Ctrl+N nova"
                           Foreground="{DynamicResource CorTextoFraco}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Atualizar" Click="Atualizar_Click" Margin="0,0,8,0" />
                <Button Content="Adicionar" Style="{StaticResource BotaoPrimario}" Click="Adicionar_Click" />
            </StackPanel>
        </Grid>

        <TextBox x:Name="campoBusca" Grid.Row="1" Margin="0,0,0,16"
                 TextChanged="Busca_Changed" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="lista">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:FaixaCentralizada />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CartaoAuth}" Click="Cartao_Click" Tag="{Binding}"
                                ToolTip="{Binding Rotulo}">
                            <StackPanel>
                                <TextBlock Text="{Binding Issuer}" FontWeight="SemiBold" FontSize="15"
                                           Foreground="{DynamicResource CorTexto}"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                                <TextBlock Text="{Binding Conta}" FontSize="12" Margin="0,4,0,0"
                                           Foreground="{DynamicResource CorTextoFraco}"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="{Binding Codigo}" FontSize="32" FontWeight="SemiBold"
                                           Margin="0,18,0,0" Foreground="{DynamicResource CorTexto}"
                                           FontFamily="Consolas" TextAlignment="Center" />

                                <Border Height="1" Background="{DynamicResource CorBorda}" Margin="0,16,0,12" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="próximo" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource CorTextoFraco}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Proximo}" FontSize="16"
                                               FontFamily="Consolas" Margin="12,0"
                                               Foreground="{DynamicResource CorTexto}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Segundos}" FontSize="12"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource CorTextoFraco}" />
                                </Grid>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="textoStatus" Grid.Row="3" Margin="0,12,0,0"
                   Foreground="{DynamicResource CorTextoFraco}" FontSize="12" TextWrapping="Wrap" />
    </Grid>
</Window>
